NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Webhook opcional: chamado via POST quando um pedido é confirmado no app.
# ORDER_WEBHOOK_URL=https://seu-servico.com/webhook/pedidos
# ORDER_WEBHOOK_SECRET=segredo-opcional

# WhatsApp Cloud API (opcional): envia o resumo do pedido para a loja.
# Sem estas variáveis, o app abre um link wa.me com a mensagem pronta.
# WHATSAPP_ACCESS_TOKEN=SEU_TOKEN_DA_META
# WHATSAPP_PHONE_NUMBER_ID=ID_DO_NUMERO_DE_NEGOCIO
# WHATSAPP_STORE_PHONE_NUMBER=556192890326
# WHATSAPP_API_VERSION=v23.0

# Chave de serviço: somente no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada para promover contas a admin via Admin API (ver supabase/admin.sql).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Meta Pixel (opcional): o script só é carregado após consentimento de Marketing.
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
